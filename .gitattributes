# Training runs write these files; bins/train/train_modal.sh copies them unchanged.
# Their log_history can pass the 20,000-byte limit for maintained files.
metrics/*.json linguist-generated=true
# The eval harness and zero-shot scoring write these; their predictions list
# passes the limit too.
results/**/*.json linguist-generated=true
# Review pages are generated from git diffs and inline every diff line.
docs/reviews/*.html linguist-generated=true
