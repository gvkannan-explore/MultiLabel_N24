#!/usr/bin/env bash
set -uo pipefail
repo_root=$(git rev-parse --show-toplevel) || exit 1
failed=0
has_commits=0
while read -r local_ref local_oid remote_ref remote_oid; do
    [[ "$local_oid" =~ ^0+$ ]] && continue
    has_commits=1
    (cd "$repo_root" && python3 scripts/check_privacy.py history --ref "$local_oid") || failed=1
    bash "$repo_root/scripts/check-secrets.sh" "--log-opts=$local_oid" || failed=1
done
if [[ "$has_commits" -eq 1 ]]; then
    bash "$repo_root/bins/ci_tasks/perform_ci.sh" || failed=1
fi
exit "$failed"
